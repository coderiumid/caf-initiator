{
  "name": "caf-initiator",
  "version": "0.1.3",
  "description": "CLI that automates the initial setup of Coderium Agent Framework (CAF) in any repo",
  "type": "module",
  "bin": {
    "caf-init": "./src/index.js"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "release": "scripts/release.sh"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderiumid/caf-initiator.git"
  },
  "keywords": [
    "cli",
    "caf",
    "agent-framework",
    "claude",
    "scaffold"
  ]
}
